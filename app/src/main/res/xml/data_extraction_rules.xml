<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes to Google cloud backup. Direct transfer to a new phone is allowed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
