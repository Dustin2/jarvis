<?xml version="1.0" encoding="utf-8"?>
<!-- Nada va al respaldo en la nube de Google. La transferencia directa a un teléfono nuevo sí se permite. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
